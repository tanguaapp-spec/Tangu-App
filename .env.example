# Supabase
# Encontre em: Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-NUNCA-EXPOR-NO-BROWSER

# Google Places API (apenas para o script de importação)
GOOGLE_PLACES_API_KEY=sua-chave-da-google-cloud

# Web Push (notificações) — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua-chave-publica-vapid
VAPID_PRIVATE_KEY=sua-chave-privada-vapid-NUNCA-EXPOR-NO-BROWSER
VAPID_SUBJECT=mailto:contato@seudominio.com
