# Supabase
# Encontre em: Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-NUNCA-EXPOR-NO-BROWSER

# Google Places API (apenas para o script de importação)
GOOGLE_PLACES_API_KEY=sua-chave-da-google-cloud

# Web Push (notificações) — gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua-chave-publica-vapid
VAPID_PRIVATE_KEY=sua-chave-privada-vapid-NUNCA-EXPOR-NO-BROWSER
VAPID_SUBJECT=mailto:contato@seudominio.com

# URL pública do site (links de e-mail, retorno do pagamento). Sem barra no fim.
NEXT_PUBLIC_SITE_URL=https://tangua-app.vercel.app

# Protege /api/cron/* (a Vercel envia "Authorization: Bearer <CRON_SECRET>" nos Cron Jobs)
CRON_SECRET=gere-um-texto-aleatorio-longo

# Sal do hash de visitante nas métricas (texto aleatório longo; não muda depois)
METRICAS_SAL=gere-outro-texto-aleatorio-longo

# Mercado Pago (planos pagos) — sem isso a contratação aparece como "ainda não disponível"
MERCADOPAGO_ACCESS_TOKEN=APP_USR-sua-credencial-de-producao
MERCADOPAGO_WEBHOOK_SECRET=assinatura-secreta-do-webhook

# Sentry (opcional)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
